# GEMINI_API_KEY: Optional for AI Studio environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted on port 3000
APP_URL="http://localhost:3000"

# PORT: Unified HTTP + Socket.IO + Vite server port (must be 3000 in AI Studio)
PORT="3000"

# JWT_SECRET: Server-side secret used to sign and verify User and Captain JWT tokens
JWT_SECRET="cabsafe-production-jwt-secret-key-change-me"

# CORS_ORIGINS: Comma-separated allowed origins for REST and Socket.IO
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:4000"

# DATA_FILE_PATH: Path to persistent embedded JSON database store (used when PERSISTENCE_MODE="file")
DATA_FILE_PATH="./.data/cabsafe-db.json"

# PERSISTENCE_MODE: "file" for local development/testing, "dynamodb" for AWS EC2 production
PERSISTENCE_MODE="file"

# AWS_REGION: Target AWS region (ap-south-1 Mumbai recommended for Chennai low latency)
# Note: Do NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in production; EC2 uses an IAM Instance Role.
AWS_REGION="ap-south-1"

# Amazon DynamoDB Table Names
DYNAMODB_USERS_TABLE="CabSafe-Users"
DYNAMODB_CAPTAINS_TABLE="CabSafe-Captains"
DYNAMODB_RIDES_TABLE="CabSafe-Rides"
DYNAMODB_BLACKLIST_TABLE="CabSafe-TokenBlacklist"

# DYNAMODB_ENDPOINT: Optional local DynamoDB endpoint for offline testing (leave empty in AWS production)
DYNAMODB_ENDPOINT=""

# REDIS_URL: Optional Redis connection URL for cross-instance Socket.IO event propagation across EC2 Auto Scaling
REDIS_URL=""

